---
// Links to every topic hub. Two looks:
//   variant="section" - compact card grid for home, products and for-buyers
//   variant="strip"   - one-line chip row for the blog index
import { getCollection } from 'astro:content';
import { TOPICS } from '../data/topics';
import { clusterOf } from '../data/clusters';

interface Props {
  variant?: 'section' | 'strip';
}
const { variant = 'section' } = Astro.props;

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const p of posts) {
  const c = clusterOf(p.slug);
  counts.set(c, (counts.get(c) ?? 0) + 1);
}
---

{variant === 'strip' ? (
  <nav class="gbt-strip" aria-label="Browse by topic">
    <div class="container gbt-strip__inner">
      <span class="gbt-strip__label">Browse by topic</span>
      <ul class="gbt-strip__chips">
        {TOPICS.map((t) => (
          <li><a class="gbt-strip__chip" href={`/topics/${t.slug}/`}>{t.short}</a></li>
        ))}
      </ul>
    </div>
  </nav>
) : (
  <section class="gbt" aria-labelledby="guides-by-topic-title">
    <div class="container">
      <div class="gbt__head">
        <p class="gbt__label">Insights</p>
        <h2 id="guides-by-topic-title" class="gbt__title">Guides by topic</h2>
        <p class="gbt__sub">Buyer guides grouped by subject, from origin and certification to market entry and pricing.</p>
      </div>
      <ul class="gbt__grid">
        {TOPICS.map((t) => (
          <li>
            <a class="gbt__card" href={`/topics/${t.slug}/`}>
              <span class="gbt__card-title">{t.title}</span>
              <span class="gbt__card-blurb">{t.blurb}</span>
              <span class="gbt__card-count">{counts.get(t.slug) ?? 0} guides</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  /* ---- section variant ---- */
  .gbt {
    background: var(--paper);
    border-block: 1px solid var(--line);
    padding: 3.5rem 0;
  }
  .gbt__head { margin-bottom: 1.75rem; max-width: 640px; }
  .gbt__label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 0 0 0.5rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--turmeric);
  }
  .gbt__title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--ink);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }
  .gbt__sub {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--slate);
    margin: 0;
    line-height: 1.6;
  }
  .gbt__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }
  .gbt__card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--turmeric);
    border-radius: 12px;
    padding: 1.1rem 1.25rem 1.2rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .gbt__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(var(--ink-rgb), 0.1);
  }
  .gbt__card-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--ink);
  }
  .gbt__card-blurb {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--slate);
    flex: 1;
  }
  .gbt__card-count {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* ---- strip variant ---- */
  .gbt-strip {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 1.1rem 0;
  }
  .gbt-strip__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .gbt-strip__label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .gbt-strip__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .gbt-strip__chip {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .gbt-strip__chip:hover {
    border-color: var(--turmeric);
    background: var(--mist);
  }

  @media (max-width: 600px) {
    .gbt { padding: 2.5rem 0; }
    .gbt__title { font-size: 1.5rem; }
    .gbt__grid { grid-template-columns: 1fr; gap: 0.75rem; }
    .gbt__card-blurb {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
