---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="For Buyers: Source Indian Botanical Ingredients"
  description="Ayris Global sources Indian botanical ingredients, herbal extracts and Ayurvedic ingredients for brands and manufacturers in 9 regions. Specification-first, documentation-first."
>

  <!-- HowTo JSON-LD Schema -->
  <script type="application/ld+json" set:html={`{"@context":"https://schema.org","@type":"HowTo","name":"How to Source Indian Botanical Ingredients Through Ayris Global","description":"How international buyers source Indian botanical ingredients through Ayris Global, from specification to order.","step":[{"@type":"HowToStep","position":1,"name":"Send your specification","text":"Share the ingredient, form, grade, certifications, volume and destination market using the contact form, email or WhatsApp."},{"@type":"HowToStep","position":2,"name":"We screen and shortlist","text":"Ayris Global screens Indian producers against the specification and aims to reply within two working days with questions or a first view."},{"@type":"HowToStep","position":3,"name":"Documentation review","text":"The buyer's QA team reviews the producer's CoA, technical data sheet and certificates before anything moves forward."},{"@type":"HowToStep","position":4,"name":"Quotation and order","text":"Ayris Global provides a delivered price on agreed Incoterms and coordinates the order, with one point of contact throughout."}]}`} slot="head" />

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero__inner">
      <span class="eyebrow">For Global Buyers</span>
      <h1 class="page-hero__title">Source Indian Botanical Ingredients with One Point of Contact</h1>
      <p class="page-hero__sub">Finding the right Indian producer for a specific grade, certification and documentation set takes time and local knowledge. Ayris Global does that work for you. We take your specification, screen Indian producers against it, review their documents, and manage the process through to order.</p>
    </div>
  </section>

  <!-- WHAT WE DO / DO NOT -->
  <section class="offer">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">How We Work</span>
        <h2 class="section-title">What We Do, and What We Do Not</h2>
        <p class="section-sub">A clear scope, so your procurement and QA teams know exactly what to expect from us.</p>
      </div>
      <div class="offer-grid offer-grid--two">
        <div class="offer-card">
          <h3 class="offer-card__title">What we do</h3>
          <ul class="scope-list">
            <li>Take your full specification: botanical name, plant part, form, active marker and test method, certifications, quantity and destination market.</li>
            <li>Screen Indian manufacturers and processors against it.</li>
            <li>Request and review producer documents before recommending anything: CoA, technical data sheet, safety data sheet, and certificates such as GMP, ISO 22000, FSSAI, organic, Halal and Kosher as relevant.</li>
            <li>Flag gaps between what a producer holds and what your market usually asks for.</li>
            <li>Provide a quotation and coordinate the order through to dispatch.</li>
            <li>Stay your single point of contact, and handle both sides of the transaction confidentially.</li>
          </ul>
        </div>
        <div class="offer-card">
          <h3 class="offer-card__title">What we do not do</h3>
          <ul class="scope-list">
            <li>Make or test ingredients in our own facility. Testing is done by the producer and, where you require it, by an accredited third-party laboratory.</li>
            <li>Present producer certifications as our own. GMP, organic, Halal and Kosher certificates belong to the producers, and we share them for your review.</li>
            <li>Act as your regulatory consultant. Decisions on Novel Food status, FDA, TGA or other local rules stay with you. We supply the producer documents you need to make them.</li>
            <li>Make health or efficacy claims about any ingredient.</li>
            <li>Commit to price or availability before documents have been reviewed.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE SOURCE FROM INDIA -->
  <section class="origin">
    <div class="container">
      <div class="origin__inner">
        <div class="origin__text">
          <span class="section-eyebrow">What We Source</span>
          <h2 class="section-title">Indian Botanical Ingredients, Sourced to Specification</h2>
          <p>We source Ayurvedic ingredients, standardised herbal extracts (HPLC-tested where specified), botanical powders, nutraceutical actives, essential oils, and dried botanicals for tea from Indian producers.</p>
          <p>Frequent enquiries include ashwagandha, turmeric and curcumin, Lakadong turmeric from Meghalaya, shatavari, moringa, tulsi and boswellia. If your ingredient is not listed, ask. Most enquiries start with something specific.</p>
          <p><a href="/products/" class="text-link">Explore ingredient categories</a></p>
        </div>
        <div class="origin__stats">
          <div class="stat">
            <span class="stat__num">1,178</span>
            <span class="stat__label">Medicinal plant species in trade in India (NMPB-FRLHT study, 2008)</span>
          </div>
          <div class="stat">
            <span class="stat__num">242</span>
            <span class="stat__label">Species traded above 100 tonnes a year (same study)</span>
          </div>
          <div class="stat">
            <span class="stat__num">6</span>
            <span class="stat__label">Ingredient categories we source</span>
          </div>
          <div class="stat">
            <span class="stat__num">9</span>
            <span class="stat__label">Regions we work with</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DOCUMENTATION BY REGION -->
  <section class="markets">
    <div class="container">
      <div class="section-header section-header--light">
        <span class="section-eyebrow section-eyebrow--gold">Where We Work</span>
        <h2 class="section-title section-title--white">Documentation by Region</h2>
        <p class="section-sub section-sub--light">Your market sets the documentation. We request what it needs from the producer, so your QA and regulatory teams can make their own decisions.</p>
      </div>
      <div class="markets-grid">
        <div class="market-card">
          <div class="market-card__region">European Union</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">CoA with pesticide residue and contaminant panels, organic certification valid for the EU where organic is claimed, and the producer documents your team needs to assess Novel Food status.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">United Kingdom</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">CoA with pesticide residue and contaminant panels, organic certification valid for Great Britain where organic is claimed, and origin documents for import.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">United States</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">CoA, the producer's FDA food facility registration, and USDA NOP organic certification where organic is claimed.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">UAE / GCC</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">Halal certificate from a body accepted in the destination market, and a certificate of origin to claim India-UAE CEPA preferential duty on qualifying goods.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">Japan</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">Detailed CoA and residue testing against Japanese limits, with batch-level traceability documents.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">Korea</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">Detailed CoA and residue testing against Korean limits, with the producer documents needed for MFDS import procedures.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">Australia &amp; New Zealand</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">CoA and the documents required by each country's import conditions, plus organic certification to the destination standard where organic is claimed.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">Southeast Asia</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">CoA, Halal certification where the market requires it, and producer documents for local product registration.</p>
        </div>
        <div class="market-card">
          <div class="market-card__region">Latin America</div>
          <div class="market-card__divider"></div>
          <p class="market-card__text">CoA and the producer documents needed for local registration with regulators such as ANVISA, COFEPRIS and INVIMA.</p>
        </div>
      </div>
    </div>
  </section>
  <!-- ═══════════════════════════════════
       WHO WE WORK WITH
  ════════════════════════════════════ -->
  <section class="buyers">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Built For</span>
        <h2 class="section-title">Who We Source For</h2>
        <p class="section-sub">Our process is built for buyers across the wellness supply chain, from early-stage brands building a first formulation to manufacturers expanding an Indian sourcing programme.</p>
      </div>

      <div class="buyers-grid">

        <div class="buyer-type">
          <span class="buyer-type__icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="18" stroke="#C9A84C" stroke-width="1.2"/>
              <path d="M14 20 Q17 13 20 12 Q23 13 26 20 Q23 27 20 28 Q17 27 14 20Z" stroke="#C9A84C" stroke-width="1.2" fill="none"/>
            </svg>
          </span>
          <h3>Supplement Brands</h3>
          <p>Brands formulating finished supplements for retail, D2C, and subscription channels. We source the standardised extracts, powders and actives that go into your capsules, tablets and powders, with the documentation your market asks for.</p>
        </div>

        <div class="buyer-type">
          <span class="buyer-type__icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="18" stroke="#C9A84C" stroke-width="1.2"/>
              <path d="M13 26 L20 12 L27 26" stroke="#C9A84C" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15.5 21 L24.5 21" stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </span>
          <h3>Functional Food &amp; Beverage</h3>
          <p>Food and drink manufacturers adding botanical actives, functional ingredients, and superfoods to their product lines. We source food-grade botanical powders, extracts and natural colours, with producer documentation for your market.</p>
        </div>

        <div class="buyer-type">
          <span class="buyer-type__icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="18" stroke="#C9A84C" stroke-width="1.2"/>
              <circle cx="20" cy="17" r="4" stroke="#C9A84C" stroke-width="1.2" fill="none"/>
              <path d="M12 30 Q12 24 20 24 Q28 24 28 30" stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round" fill="none"/>
            </svg>
          </span>
          <h3>Herbal Tea &amp; Wellness Beverage</h3>
          <p>Tea blenders, herbal infusion brands, and functional beverage producers sourcing culinary-grade dried botanicals - tulsi, hibiscus, chamomile, rose petals, moringa, and spice blends. We source to your specification for colour, aroma and microbiological limits.</p>
        </div>

        <div class="buyer-type">
          <span class="buyer-type__icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="18" stroke="#C9A84C" stroke-width="1.2"/>
              <path d="M20 13 L20 20 L26 24" stroke="#C9A84C" stroke-width="1.4" stroke-linecap="round"/>
              <path d="M14 16 Q11 20 14 24" stroke="#C9A84C" stroke-width="1.1" fill="none" stroke-linecap="round"/>
              <path d="M26 16 Q29 20 26 24" stroke="#C9A84C" stroke-width="1.1" fill="none" stroke-linecap="round"/>
            </svg>
          </span>
          <h3>Natural Cosmetic &amp; Beauty</h3>
          <p>Skincare, haircare, and beauty supplement brands sourcing botanical actives, essential oils, and plant-derived ingredients. We source cosmetic-grade botanicals and request INCI names, allergen declarations and IFRA documents from the producer where available.</p>
        </div>

        <div class="buyer-type">
          <span class="buyer-type__icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="18" stroke="#C9A84C" stroke-width="1.2"/>
              <rect x="14" y="14" width="12" height="14" rx="1" stroke="#C9A84C" stroke-width="1.2" fill="none"/>
              <path d="M17 19 L23 19 M17 23 L21 23" stroke="#C9A84C" stroke-width="1" stroke-linecap="round"/>
            </svg>
          </span>
          <h3>Private Label &amp; Contract Manufacturers</h3>
          <p>Contract manufacturers and private label producers who need documented botanical ingredients to serve their own brand clients. We work to your specifications and documentation requirements.</p>
        </div>

        <div class="buyer-type">
          <span class="buyer-type__icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="18" stroke="#C9A84C" stroke-width="1.2"/>
              <path d="M13 20 Q14 14 20 13 Q26 14 27 20 Q26 26 20 27 Q14 26 13 20Z" stroke="#C9A84C" stroke-width="1.2" fill="none"/>
              <circle cx="20" cy="20" r="2.5" fill="#C9A84C"/>
            </svg>
          </span>
          <h3>Ingredient Distributors</h3>
          <p>Regional ingredient distributors building their Indian botanical portfolio for resale to downstream food, supplement, and cosmetic manufacturers. We source at distributor volumes and request the documentation your customers require.</p>
        </div>

      </div>
    </div>
  </section>


  <!-- WHY SOURCE FROM INDIA -->
  <section class="trade">
    <div class="container">
      <div class="trade__inner">
        <div class="trade__text">
          <span class="section-eyebrow">Sourcing Context</span>
          <h2 class="section-title">Why Source Botanicals from India</h2>
          <p>India is one of the world's most important origins for medicinal and wellness botanicals. These are the facts we rely on when we talk to buyers about it.</p>
        </div>
        <div class="trade__advantages">
          <div class="advantage">
            <div class="advantage__marker" aria-hidden="true"></div>
            <div class="advantage__content">
              <h4>Range of species</h4>
              <p>An estimated 1,178 medicinal plant species are in trade in India, with 242 traded above 100 tonnes a year, according to a National Medicinal Plants Board and FRLHT study (2008).</p>
            </div>
          </div>
          <div class="advantage">
            <div class="advantage__marker" aria-hidden="true"></div>
            <div class="advantage__content">
              <h4>Certified producers</h4>
              <p>Many Indian producers hold GMP, ISO 22000, FSSAI, organic, Halal and Kosher certification. Which certificates a given producer holds varies, which is why we review them before recommending anyone.</p>
            </div>
          </div>
          <div class="advantage">
            <div class="advantage__marker" aria-hidden="true"></div>
            <div class="advantage__content">
              <h4>Standardised extracts</h4>
              <p>Indian extract manufacturers commonly supply material standardised to defined markers, such as withanolides in ashwagandha, curcuminoids in turmeric and AKBA in boswellia, with test methods stated on the CoA.</p>
            </div>
          </div>
          <div class="advantage">
            <div class="advantage__marker" aria-hidden="true"></div>
            <div class="advantage__content">
              <h4>Trade agreements</h4>
              <p>The India-UAE CEPA has been in force since 2022 and the India-EFTA TEPA since 2025. India also trades with ASEAN under the ASEAN-India agreement, and the India-EU free trade agreement was concluded in January 2026 and is pending ratification.</p>
            </div>
          </div>
          <div class="advantage">
            <div class="advantage__marker" aria-hidden="true"></div>
            <div class="advantage__content">
              <h4>Depth of tradition</h4>
              <p>Classical Ayurvedic texts such as the Charaka Samhita, roughly two thousand years old, describe many of the botanicals still traded today.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       CREDENTIALS
  ════════════════════════════════════ -->
  <section class="credentials">
    <div class="container">
      <h2 class="credentials__title">Certifications We Source To</h2>
      <p class="credentials__sub">Producer certifications we request, depending on your market. These are held by the producers, not by Ayris Global.</p>
      <div class="certs-grid">
        <div class="cert-card">
          <span class="cert-card__badge">GMP</span>
          <span class="cert-card__name">Good Manufacturing Practice</span>
          <span class="cert-card__markets">EU · UK · USA · Japan · Korea · ANZ</span>
        </div>
        <div class="cert-card">
          <span class="cert-card__badge">ISO</span>
          <span class="cert-card__name">ISO 22000 / ISO 9001</span>
          <span class="cert-card__markets">All markets</span>
        </div>
        <div class="cert-card">
          <span class="cert-card__badge">FSSAI</span>
          <span class="cert-card__name">Food Safety & Standards Authority of India</span>
          <span class="cert-card__markets">Export compliance</span>
        </div>
        <div class="cert-card">
          <span class="cert-card__badge">Organic</span>
          <span class="cert-card__name">NPOP (India) / NOP (USA)</span>
          <span class="cert-card__markets">EU · UK · USA · ANZ</span>
        </div>
        <div class="cert-card">
          <span class="cert-card__badge">Halal</span>
          <span class="cert-card__name">Halal Certification</span>
          <span class="cert-card__markets">UAE/GCC · SEA · UK · EU</span>
        </div>
        <div class="cert-card">
          <span class="cert-card__badge">Kosher</span>
          <span class="cert-card__name">Kosher Certification</span>
          <span class="cert-card__markets">USA · EU · select markets</span>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="process">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">The Process</span>
        <h2 class="section-title">From Specification to Order</h2>
        <p class="section-sub">Documentation first. Nothing moves forward until your team is satisfied with what the producer holds.</p>
      </div>
      <div class="process-steps">
        <div class="process-step">
          <div class="process-step__num">1</div>
          <div class="process-step__content">
            <h3>Send Your Specification</h3>
            <p>Ingredient, form, grade, certifications, volume and destination market. Use the contact form, email or WhatsApp.</p>
          </div>
        </div>
        <div class="process-step__connector" aria-hidden="true"></div>
        <div class="process-step">
          <div class="process-step__num">2</div>
          <div class="process-step__content">
            <h3>We Screen &amp; Shortlist</h3>
            <p>We screen Indian producers against your specification and aim to reply within two working days with questions or a first view.</p>
          </div>
        </div>
        <div class="process-step__connector" aria-hidden="true"></div>
        <div class="process-step">
          <div class="process-step__num">3</div>
          <div class="process-step__content">
            <h3>Documentation Review</h3>
            <p>Your QA team reviews the producer's CoA, technical data sheet and certificates before anything moves forward.</p>
          </div>
        </div>
        <div class="process-step__connector" aria-hidden="true"></div>
        <div class="process-step">
          <div class="process-step__num">4</div>
          <div class="process-step__content">
            <h3>Quotation &amp; Order</h3>
            <p>A delivered price on agreed Incoterms, with the order coordinated through Ayris Global. One point of contact throughout.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="container">
      <div class="cta-band__inner">
        <h2 class="cta-band__title">Ready to start a sourcing conversation?</h2>
        <p class="cta-band__sub">Send your specification, or tell us what you are exploring. We handle buyer and producer identities confidentially, and you deal with Ayris Global throughout.</p>
        <div class="cta-band__actions">
          <a href="/contact/" class="btn btn--primary btn--lg">Submit a Sourcing Enquiry</a>
          <a href="/products/" class="btn btn--ghost btn--lg">Explore Ingredient Categories</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─────────────────────────────
     PAGE HERO
  ───────────────────────────── */
  .page-hero {
    background: #1B2B4B;
    padding: 7rem 1.5rem 5rem;
    text-align: center;
  }

  .page-hero__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .eyebrow {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(201,168,76,0.75);
    margin-bottom: 1rem;
  }

  .page-hero__title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 400;
    color: #FAFAF8;
    margin: 0 0 1.4rem;
    line-height: 1.18;
  }

  .page-hero__sub {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: rgba(250,250,248,0.75);
    line-height: 1.8;
    margin: 0;
    font-weight: 300;
  }

  /* ─────────────────────────────
     CONTAINER
  ───────────────────────────── */
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ─────────────────────────────
     SECTION HEADERS
  ───────────────────────────── */
  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-header--light {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-eyebrow {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 0.75rem;
  }

  .section-eyebrow--gold { color: #C9A84C; }

  .section-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: #1B2B4B;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .section-title--white { color: #FAFAF8; }

  .section-sub {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #555;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.75;
  }

  .section-sub--light {
    color: rgba(250,250,248,0.65);
  }

  /* ─────────────────────────────
     ORIGIN SECTION
  ───────────────────────────── */
  .origin {
    background: #FAFAF8;
    padding: 6rem 0;
  }

  .origin__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .origin__text .section-eyebrow {
    margin-bottom: 0.75rem;
  }

  .origin__text .section-title {
    margin-bottom: 1.5rem;
  }

  .origin__text p {
    font-family: 'Inter', sans-serif;
    font-size: 0.97rem;
    color: #444;
    line-height: 1.8;
    margin: 0 0 1.1rem;
  }

  .origin__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: 4.2rem;
  }

  .stat {
    background: #fff;
    border: 1px solid rgba(27,43,75,0.09);
    border-radius: 4px;
    padding: 1.5rem 1.25rem;
    text-align: center;
  }

  .stat__num {
    display: block;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 2.2rem;
    color: #C9A84C;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat__label {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: #666;
    line-height: 1.4;
  }

  /* ─────────────────────────────
     OFFER SECTION
  ───────────────────────────── */
  .offer {
    background: #fff;
    padding: 6rem 0;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
