obal.in/images/products/boswellia-extract.jpg"}},{"@type":"ListItem","position":6,"item":{"@type":"Product","name":"Guduchi Extract","alternateName":"Tinospora cordifolia","category":"Herbal Extracts","description":"Stem extract and powder, standardised to customer specification. A classical Ayurvedic herb.","image":"https://ayrisglobal.in/images/products/guduchi-extract.jpg"}},{"@type":"ListItem","position":7,"item":{"@type":"Product","name":"Moringa Powder","alternateName":"Moringa oleifera","category":"Botanical Powders","description":"Leaf powder containing all essential amino acids, with notable iron and micronutrient content. Used in health food and functional food products.","image":"https://ayrisglobal.in/images/products/moringa-powder.jpg"}},{"@type":"ListItem","position":8,"item":{"@type":"Product","name":"Amla Powder","alternateName":"Phyllanthus emblica","category":"Botanical Powders","description":"Indian gooseberry fruit powder, a recognised natural source of vitamin C. Used in supplement, hair care and food formulations.","image":"https://ayrisglobal.in/images/products/amla-powder.jpg"}},{"@type":"ListItem","position":9,"item":{"@type":"Product","name":"Neem Powder","alternateName":"Azadirachta indica","category":"Botanical Powders","description":"Leaf and seed powder. Widely used in cosmetic formulations, nutraceutical capsules, and functional wellness products across EU, UK and Middle East markets.","image":"https://ayrisglobal.in/images/products/neem-powder.jpg"}},{"@type":"ListItem","position":10,"item":{"@type":"Product","name":"Curcumin (Turmeric Extract)","alternateName":"Curcuma longa","category":"Nutraceutical Ingredients","description":"Standardised to 95% curcuminoids. Among the most researched botanicals, and a core supplement ingredient.","image":"https://ayrisglobal.in/images/products/curcumin.jpg"}},{"@type":"ListItem","position":11,"item":{"@type":"Product","name":"Piperine (Black Pepper Extract)","alternateName":"Piper nigrum","category":"Nutraceutical Ingredients","description":"Standardised to 95% piperine. Commonly paired with curcumin in supplement formulations.","image":"https://ayrisglobal.in/images/products/piperine.jpg"}},{"@type":"ListItem","position":12,"item":{"@type":"Product","name":"Triphala","alternateName":"Amla, Haritaki, Bibhitaki","category":"Nutraceutical Ingredients","description":"The classical Ayurvedic three-fruit formula, as standardised extract and traditional powder. Used in digestive wellness formulations.","image":"https://ayrisglobal.in/images/products/triphala.jpg"}},{"@type":"ListItem","position":13,"item":{"@type":"Product","name":"Cardamom Oil","alternateName":"Elettaria cardamomum","category":"Essential Oils","description":"Steam-distilled from Kerala green cardamom pods. Used in fragrance, food flavouring and aromatherapy.","image":"https://ayrisglobal.in/images/products/cardamom-oil.jpg"}},{"@type":"ListItem","position":14,"item":{"@type":"Product","name":"Vetiver Oil","alternateName":"Chrysopogon zizanioides","category":"Essential Oils","description":"Indian vetiver (khus), steam-distilled root oil with a distinctive earthy, woody profile. A key base note in luxury fragrances and a growing ingredient in ayurvedic skincare formulations.","image":"https://ayrisglobal.in/images/products/vetiver-oil.jpg"}},{"@type":"ListItem","position":15,"item":{"@type":"Product","name":"Ginger Oil","alternateName":"Zingiber officinale","category":"Essential Oils","description":"CO2 and steam-distilled from Indian ginger rhizomes. Used in food flavouring, digestive wellness formulations, and sports recovery products across all major global markets.","image":"https://ayrisglobal.in/images/products/ginger-oil.jpg"}},{"@type":"ListItem","position":16,"item":{"@type":"Product","name":"Rose Petals","alternateName":"Rosa damascena","category":"Natural Wellness Ingredients","description":"Dried whole rose petals, used in herbal teas, Ayurvedic skincare and beauty formulations.","image":"https://ayrisglobal.in/images/products/rose-petals.jpg"}},{"@type":"ListItem","position":17,"item":{"@type":"Product","name":"Hibiscus","alternateName":"Hibiscus sabdariffa","category":"Natural Wellness Ingredients","description":"Dried calyx used in herbal teas, functional beverages and wellness formulations for its colour and flavour.","image":"https://ayrisglobal.in/images/products/hibiscus.jpg"}},{"@type":"ListItem","position":18,"item":{"@type":"Product","name":"Chamomile","alternateName":"Matricaria chamomilla","category":"Natural Wellness Ingredients","description":"Dried chamomile flowers, whole and cut grades available. A staple of herbal tea blends.","image":"https://ayrisglobal.in/images/products/chamomile.jpg"}}]}`} slot="head" />

  <!-- ═══════════════════════════════════
       PAGE HERO
  ════════════════════════════════════ -->
  <section class="page-hero">
    <div class="page-hero__inner">
      <span class="eyebrow">What We Source</span>
      <h1 class="page-hero__title">Ingredient Categories</h1>
      <p class="page-hero__sub">Six category families, sourced from documented Indian producers and matched to the requirements of your market. Enquiries are welcome beyond the ingredients shown here.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       CATEGORY 1: AYURVEDIC INGREDIENTS
  ════════════════════════════════════ -->
  <section class="category" id="ayurvedic">
    <div class="container">
      <div class="category__layout">

        <div class="category__hero">
          <img
            src="/images/products/category-ayurvedic.jpg"
            alt="Traditional Ayurvedic preparation with mortar and pestle, Gujarat India"
            loading="lazy"
            width="700"
            height="500"
          />
          <div class="category__hero-badge">
            <span>Category 01</span>
          </div>
        </div>

        <div class="category__content">
          <span class="category__eyebrow">Rooted in classical Ayurveda</span>
          <h2 class="category__title">Ayurvedic Ingredients</h2>
          <p class="category__desc">The foundational botanicals of Ayurveda - India's classical system of medicine. These are the adaptogens, rasayanas, and tonic herbs that global supplement brands, functional food producers, and wellness formulators are building their most credible product lines around.</p>
          <p class="category__certs-label">Available from producers, by enquiry:</p>
          <ul class="category__certs">
            <li>GMP certified</li>
            <li>FSSAI licensed</li>
            <li>Organic (NPOP/NOP)</li>
            <li>Standardised extracts available</li>
          </ul>

          <div class="ingredient-cards">

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/ashwagandha.jpg" alt="Ashwagandha plant" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Ashwagandha</h3>
                <p class="latin">Withania somnifera</p>
                <p>Root extract standardised to withanolides, and root powder. One of the most widely traded Ayurvedic adaptogens.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/shatavari.jpg" alt="Shatavari root" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Shatavari</h3>
                <p class="latin">Asparagus racemosus</p>
                <p>Root powder and extract. A classical Ayurvedic tonic used in women's wellness formulations.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/brahmi.jpg" alt="Brahmi plant" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Brahmi</h3>
                <p class="latin">Bacopa monnieri</p>
                <p>Aerial extract standardised to bacosides, and powder. Used in cognitive-support supplement formulations.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       CATEGORY 2: HERBAL EXTRACTS
  ════════════════════════════════════ -->
  <section class="category category--alt" id="extracts">
    <div class="container">
      <div class="category__layout category__layout--reverse">

        <div class="category__hero">
          <img
            src="/images/products/category-extracts.jpg"
            alt="Amber glass dropper bottle containing herbal extract"
            loading="lazy"
            width="700"
            height="500"
          />
          <div class="category__hero-badge">
            <span>Category 02</span>
          </div>
        </div>

        <div class="category__content">
          <span class="category__eyebrow">Precision standardisation</span>
          <h2 class="category__title">Herbal Extracts</h2>
          <p class="category__desc">Concentrated botanical extracts with defined active content - standardised by HPLC, UV, or gravimetric methods. Supplied as dry powders, liquid extracts, or encapsulated forms. Batch CoA, SDS and origin documents are requested with every enquiry.</p>
          <p class="category__certs-label">Available from producers, by enquiry:</p>
          <ul class="category__certs">
            <li>HPLC-standardised actives</li>
            <li>ISO 22000 / ISO 9001</li>
            <li>Halal & Kosher available</li>
            <li>Documentation for EU, UK, US imports</li>
          </ul>

          <div class="ingredient-cards">

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/tulsi-extract.jpg" alt="Tulsi holy basil leaves extract" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Tulsi Extract</h3>
                <p class="latin">Ocimum tenuiflorum</p>
                <p>Leaf extract standardised to ursolic acid and eugenol. Used by functional tea and supplement brands.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/boswellia-extract.jpg" alt="Boswellia frankincense resin" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Boswellia Extract</h3>
                <p class="latin">Boswellia serrata</p>
                <p>AKBA-standardised Indian frankincense extract. A widely used joint-health ingredient.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/guduchi-extract.jpg" alt="Guduchi plant extract" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Guduchi Extract</h3>
                <p class="latin">Tinospora cordifolia</p>
                <p>Stem extract and powder, standardised to customer specification. A classical Ayurvedic herb.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       CATEGORY 3: BOTANICAL POWDERS
  ════════════════════════════════════ -->
  <section class="category" id="powders">
    <div class="container">
      <div class="category__layout">

        <div class="category__hero">
          <img
            src="/images/products/category-powders.jpg"
            alt="Fine green botanical powder on wooden spoon"
            loading="lazy"
            width="700"
            height="500"
          />
          <div class="category__hero-badge">
            <span>Category 03</span>
          </div>
        </div>

        <div class="category__content">
          <span class="category__eyebrow">Whole ingredient integrity</span>
          <h2 class="category__title">Botanical Powders</h2>
          <p class="category__desc">Whole-plant and single-part botanical powders - dried, milled, and sieved to specification. Used in finished supplements, functional foods, teas, smoothie blends, and cosmetic formulations. Available in conventional, organic, and spray-dried formats.</p>
          <p class="category__certs-label">Available from producers, by enquiry:</p>
          <ul class="category__certs">
            <li>Organic NPOP / NOP certified</li>
            <li>Mesh size to specification</li>
            <li>Heavy metal tested</li>
            <li>Pesticide residue screened</li>
          </ul>

          <div class="ingredient-cards">

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/moringa-powder.jpg" alt="Moringa leaf powder" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Moringa Powder</h3>
                <p class="latin">Moringa oleifera</p>
                <p>Leaf powder containing all essential amino acids, with notable iron and micronutrient content. Used in health food and functional food products.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/amla-powder.jpg" alt="Amla Indian gooseberry powder" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Amla Powder</h3>
                <p class="latin">Phyllanthus emblica</p>
                <p>Indian gooseberry fruit powder, a recognised natural source of vitamin C. Used in supplement, hair care and food formulations.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/neem-powder.jpg" alt="Neem leaf powder" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Neem Powder</h3>
                <p class="latin">Azadirachta indica</p>
                <p>Leaf and seed powder. Widely used in cosmetic formulations, nutraceutical capsules, and functional wellness products across EU, UK and Middle East markets.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       CATEGORY 4: NUTRACEUTICAL INGREDIENTS
  ════════════════════════════════════ -->
  <section class="category category--alt" id="nutraceuticals">
    <div class="container">
      <div class="category__layout category__layout--reverse">

        <div class="category__hero">
          <img
            src="/images/products/category-nutraceuticals.jpg"
            alt="Ayurvedic supplement bottles and wellness products"
            loading="lazy"
            width="700"
            height="500"
          />
          <div class="category__hero-badge">
            <span>Category 04</span>
          </div>
        </div>

        <div class="category__content">
          <span class="category__eyebrow">Active ingredient science</span>
          <h2 class="category__title">Nutraceutical Ingredients</h2>
          <p class="category__desc">Active botanical ingredients for inclusion in dietary supplements, functional foods, and nutraceutical formulations. We request full technical documentation from the producer, including CoA, SDS and stability data, to support procurement in regulated markets.</p>
          <p class="category__certs-label">Available from producers, by enquiry:</p>
          <ul class="category__certs">
            <li>GMP, ISO 22000</li>
            <li>EU Novel Food status guidance</li>
            <li>Producer FDA food facility registration</li>
            <li>Full technical dossier available</li>
          </ul>

          <div class="ingredient-cards">

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/curcumin.jpg" alt="Turmeric powder, source of curcumin" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Curcumin (Turmeric Extract)</h3>
                <p class="latin">Curcuma longa</p>
                <p>Standardised to 95% curcuminoids. Among the most researched botanicals, and a core supplement ingredient.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/piperine.jpg" alt="Black pepper piperine spice" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Piperine (Black Pepper Extract)</h3>
                <p class="latin">Piper nigrum</p>
                <p>Standardised to 95% piperine. Commonly paired with curcumin in supplement formulations.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/triphala.jpg" alt="Triphala Ayurvedic formula" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Triphala</h3>
                <p class="latin">Amla, Haritaki, Bibhitaki</p>
                <p>The classical Ayurvedic three-fruit formula, as standardised extract and traditional powder. Used in digestive wellness formulations.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       CATEGORY 5: ESSENTIAL OILS
  ════════════════════════════════════ -->
  <section class="category" id="essential-oils">
    <div class="container">
      <div class="category__layout">

        <div class="category__hero">
          <img
            src="/images/products/category-essential-oils.jpg"
            alt="Three essential oil bottles on white surface"
            loading="lazy"
            width="700"
            height="500"
          />
          <div class="category__hero-badge">
            <span>Category 05</span>
          </div>
        </div>

        <div class="category__content">
          <span class="category__eyebrow">Steam-distilled, cold-pressed, CO₂ extracted</span>
          <h2 class="category__title">Essential Oils</h2>
          <p class="category__desc">India is an established origin for essential oils, from steam-distilled spice oils in Kerala to CO₂-extracted botanical oils. Batches are GC-MS tested by the producer, with quality documentation requested for every enquiry.</p>
          <p class="category__certs-label">Available from producers, by enquiry:</p>
          <ul class="category__certs">
            <li>GC-MS tested by the producer</li>
            <li>IFRA compliance guidance</li>
            <li>Food grade and cosmetic grade</li>
            <li>Halal certified available</li>
          </ul>

          <div class="ingredient-cards">

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/cardamom-oil.jpg" alt="Cardamom essential oil" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Cardamom Oil</h3>
                <p class="latin">Elettaria cardamomum</p>
                <p>Steam-distilled from Kerala green cardamom pods. Used in fragrance, food flavouring and aromatherapy.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/vetiver-oil.jpg" alt="Vetiver root, dried fibers used for steam distillation" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Vetiver Oil</h3>
                <p class="latin">Chrysopogon zizanioides</p>
                <p>Indian vetiver (khus) - steam-distilled root oil with a distinctive earthy, woody profile. A key base note in luxury fragrances and a growing ingredient in ayurvedic skincare formulations.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/ginger-oil.jpg" alt="Ginger essential oil root" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Ginger Oil</h3>
                <p class="latin">Zingiber officinale</p>
                <p>CO₂ and steam-distilled from Indian ginger rhizomes. Used in food flavouring, digestive wellness formulations, and sports recovery products across all major global markets.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       CATEGORY 6: NATURAL WELLNESS
  ════════════════════════════════════ -->
  <section class="category category--alt" id="natural-wellness">
    <div class="container">
      <div class="category__layout category__layout--reverse">

        <div class="category__hero">
          <img
            src="/images/products/category-natural-wellness.jpg"
            alt="Vibrant red hibiscus botanical flower"
            loading="lazy"
            width="700"
            height="500"
          />
          <div class="category__hero-badge">
            <span>Category 06</span>
          </div>
        </div>

        <div class="category__content">
          <span class="category__eyebrow">Flowers, roots & botanicals</span>
          <h2 class="category__title">Natural Wellness Ingredients</h2>
          <p class="category__desc">Edible botanicals, functional flowers, and wellness-grade plant ingredients used in herbal teas, functional beverages, beauty supplements, and natural cosmetic formulations. From rose petals to hibiscus, sourced at origin and processed to specification.</p>
          <p class="category__certs-label">Available from producers, by enquiry:</p>
          <ul class="category__certs">
            <li>Food-grade processing</li>
            <li>Organic NPOP certified</li>
            <li>GMP handling and storage</li>
            <li>Functional beverage grade</li>
          </ul>

          <div class="ingredient-cards">

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/rose-petals.jpg" alt="Rose petals dried" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Rose Petals</h3>
                <p class="latin">Rosa damascena</p>
                <p>Dried whole rose petals, used in herbal teas, Ayurvedic skincare and beauty formulations.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/hibiscus.jpg" alt="Hibiscus flowers" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Hibiscus</h3>
                <p class="latin">Hibiscus sabdariffa</p>
                <p>Dried calyx used in herbal teas, functional beverages and wellness formulations for its colour and flavour.</p>
              </div>
            </div>

            <div class="ingredient-card--sm">
              <div class="ingredient-card--sm__img">
                <img src="/images/products/chamomile.jpg" alt="Chamomile flowers dried" loading="lazy" width="320" height="220"/>
              </div>
              <div class="ingredient-card--sm__body">
                <h3>Chamomile</h3>
                <p class="latin">Matricaria chamomilla</p>
                <p>Dried chamomile flowers, whole and cut grades available. A staple of herbal tea blends.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       DOCUMENTATION STRIP
  ════════════════════════════════════ -->
  <section class="doc-strip">
    <div class="container">
      <div class="doc-strip__inner">
        <h2 class="doc-strip__title">Documentation-first, for every ingredient</h2>
        <p class="doc-strip__sub">We know that documentation is the difference between a sample that converts and one that stalls in your procurement process. For every enquiry, we request a documentation package from the producer, matched to your market's import requirements.</p>
        <div class="doc-grid">
          <div class="doc-item">
            <span class="doc-item__icon">CoA</span>
            <span class="doc-item__label">Certificate of Analysis</span>
          </div>
          <div class="doc-item">
            <span class="doc-item__icon">MSDS</span>
