---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ingredient Categories"
  description="Indian botanical ingredients sourced by Ayris Global: Ayurvedic ingredients, herbal extracts, botanical powders, nutraceuticals, essential oils and natural wellness ingredients, documentation-first."
>

  <!-- Product/ItemList JSON-LD Schema (Session 28) -->
