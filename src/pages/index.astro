---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidesByTopic from '../components/GuidesByTopic.astro';
---

<BaseLayout
  title="Ayris Global - Premium Indian Botanical Ingredients, Global Supply"
  description="Ayris Global sources Indian botanical ingredients from documented, certified producers for wellness buyers across the EU, UK, USA, UAE/GCC, Japan, Korea, ANZ and beyond."
>

  <!-- ═══════════════════════════════════════════════
       HERO SECTION
  ════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__inner">

      <!-- BOTANICAL ARCH SVG -->
      <div class="hero__arch" aria-hidden="true">
        <svg viewBox="0 0 520 160" fill="none" xmlns="http://www.w3.org/2000/svg" class="arch-svg">
          <!-- Left branch -->
          <path d="M260 148 Q200 120 150 90 Q110 65 80 30" stroke="var(--turmeric)" stroke-width="1.2" fill="none" opacity="0.7"/>
          <path d="M260 148 Q195 125 140 100 Q100 78 65 48" stroke="var(--turmeric)" stroke-width="0.7" fill="none" opacity="0.4"/>
          <!-- Left leaves -->
          <ellipse cx="80" cy="30" rx="7" ry="3.5" fill="var(--turmeric)" opacity="0.6" transform="rotate(-40 80 30)"/>
          <ellipse cx="110" cy="52" rx="5.5" ry="2.5" fill="var(--turmeric)" opacity="0.45" transform="rotate(-30 110 52)"/>
          <ellipse cx="145" cy="78" rx="5" ry="2.2" fill="var(--turmeric)" opacity="0.4" transform="rotate(-20 145 78)"/>
          <ellipse cx="65" cy="48" rx="5" ry="2" fill="var(--turmeric)" opacity="0.3" transform="rotate(-50 65 48)"/>
          <!-- Right branch -->
          <path d="M260 148 Q320 120 370 90 Q410 65 440 30" stroke="var(--turmeric)" stroke-width="1.2" fill="none" opacity="0.7"/>
          <path d="M260 148 Q325 125 380 100 Q420 78 455 48" stroke="var(--turmeric)" stroke-width="0.7" fill="none" opacity="0.4"/>
          <!-- Right leaves -->
          <ellipse cx="440" cy="30" rx="7" ry="3.5" fill="var(--turmeric)" opacity="0.6" transform="rotate(40 440 30)"/>
          <ellipse cx="410" cy="52" rx="5.5" ry="2.5" fill="var(--turmeric)" opacity="0.45" transform="rotate(30 410 52)"/>
          <ellipse cx="375" cy="78" rx="5" ry="2.2" fill="var(--turmeric)" opacity="0.4" transform="rotate(20 375 78)"/>
          <ellipse cx="455" cy="48" rx="5" ry="2" fill="var(--turmeric)" opacity="0.3" transform="rotate(50 455 48)"/>
          <!-- Central lotus ornament -->
          <g transform="translate(260,148)">
            <!-- Petals -->
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.8"/>
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.8" transform="rotate(45)"/>
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.8" transform="rotate(90)"/>
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.8" transform="rotate(135)"/>
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.6" transform="rotate(22.5)"/>
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.6" transform="rotate(67.5)"/>
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.6" transform="rotate(112.5)"/>
            <ellipse cx="0" cy="-11" rx="4" ry="7" fill="var(--turmeric)" opacity="0.6" transform="rotate(157.5)"/>
            <!-- Centre -->
            <circle cx="0" cy="0" r="4.5" fill="var(--turmeric)" opacity="0.9"/>
            <circle cx="0" cy="0" r="2.5" fill="var(--ink)"/>
          </g>
          <!-- Fade rule left -->
          <line x1="20" y1="155" x2="230" y2="155" stroke="url(#fadeLeft)" stroke-width="0.8"/>
          <!-- Fade rule right -->
          <line x1="290" y1="155" x2="500" y2="155" stroke="url(#fadeRight)" stroke-width="0.8"/>
          <defs>
            <linearGradient id="fadeLeft" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="var(--turmeric)" stop-opacity="0"/>
              <stop offset="100%" stop-color="var(--turmeric)" stop-opacity="0.6"/>
            </linearGradient>
            <linearGradient id="fadeRight" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="var(--turmeric)" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="var(--turmeric)" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- WORDMARK -->
      <div class="hero__brand">
        <h1 class="hero__wordmark">AYRIS GLOBAL</h1>
        <div class="hero__rule-group" aria-hidden="true">
          <span class="rule rule--left"></span>
          <span class="rule__diamond"></span>
          <span class="rule rule--right"></span>
        </div>
        <p class="hero__tagline">Intelligence. Connection. Growth.</p>
      </div>

      <!-- RULE BELOW WORDMARK -->
      <div class="hero__divider" aria-hidden="true"></div>

      <!-- HERO BODY -->
      <div class="hero__body">
        <p class="hero__lead">
          India's botanical heritage, sourced for wellness brands, manufacturers and distributors worldwide.
          Documented producers. Specification-first sourcing. One point of contact.
        </p>
        <div class="hero__cta-group">
          <a href="/products/" class="btn btn--primary">Explore Ingredients</a>
          <a href="/contact/" class="btn btn--outline">Start a Sourcing Conversation</a>
        </div>
      </div>

      <!-- MARKET BADGES -->
      <div class="hero__markets">
        <span class="market-badge">EU</span>
        <span class="market-badge">UK</span>
        <span class="market-badge">USA</span>
        <span class="market-badge">UAE / GCC</span>
        <span class="market-badge">Japan</span>
        <span class="market-badge">Korea</span>
        <span class="market-badge">ANZ</span>
        <span class="market-badge">Southeast Asia</span>
        <span class="market-badge">Latin America</span>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FEATURED INGREDIENTS STRIP
  ════════════════════════════════════════════════ -->
  <section class="ingredients-strip">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Source of Wellness</span>
        <h2 class="section-title">Featured Ingredients</h2>
        <p class="section-sub">Six of India's most traded botanicals, each with a long history of traditional use.</p>
      </div>

      <div class="ingredients-grid">

        <a href="/products/" class="ingredient-card">
          <div class="ingredient-card__img-wrap">
            <img
              src="/images/products/ashwagandha.jpg"
              alt="Ashwagandha root and powder"
              loading="lazy"
              width="480"
              height="320"
            />
            <div class="ingredient-card__overlay"></div>
          </div>
          <div class="ingredient-card__body">
            <h3 class="ingredient-card__name">Ashwagandha</h3>
            <p class="ingredient-card__latin">Withania somnifera</p>
            <p class="ingredient-card__desc">Root extract standardised to withanolides, and root powder. India's best-known adaptogen.</p>
            <span class="ingredient-card__link">View specifications →</span>
          </div>
        </a>

        <a href="/products/" class="ingredient-card">
          <div class="ingredient-card__img-wrap">
            <img
              src="/images/home/turmeric-root.jpg"
              alt="Fresh turmeric root"
              loading="lazy"
              width="480"
              height="320"
            />
            <div class="ingredient-card__overlay"></div>
          </div>
          <div class="ingredient-card__body">
            <h3 class="ingredient-card__name">Turmeric</h3>
            <p class="ingredient-card__latin">Curcuma longa</p>
            <p class="ingredient-card__desc">Curcumin 95% standardised extract and whole root powder. Among the most researched botanicals.</p>
            <span class="ingredient-card__link">View specifications →</span>
          </div>
        </a>

        <a href="/products/" class="ingredient-card">
          <div class="ingredient-card__img-wrap">
            <img
              src="/images/products/tulsi-extract.jpg"
              alt="Tulsi Holy Basil fresh leaves"
              loading="lazy"
              width="480"
              height="320"
            />
            <div class="ingredient-card__overlay"></div>
          </div>
          <div class="ingredient-card__body">
            <h3 class="ingredient-card__name">Tulsi</h3>
            <p class="ingredient-card__latin">Ocimum tenuiflorum</p>
            <p class="ingredient-card__desc">Holy Basil leaf powder and extract, central to Ayurvedic tradition and widely used in functional teas.</p>
            <span class="ingredient-card__link">View specifications →</span>
          </div>
        </a>

        <a href="/products/" class="ingredient-card">
          <div class="ingredient-card__img-wrap">
            <img
              src="/images/products/moringa-powder.jpg"
              alt="Moringa leaves and powder"
              loading="lazy"
              width="480"
              height="320"
            />
            <div class="ingredient-card__overlay"></div>
          </div>
          <div class="ingredient-card__body">
            <h3 class="ingredient-card__name">Moringa</h3>
            <p class="ingredient-card__latin">Moringa oleifera</p>
            <p class="ingredient-card__desc">Leaf powder and extract, valued for its protein, iron and micronutrient content.</p>
            <span class="ingredient-card__link">View specifications →</span>
          </div>
        </a>

        <a href="/products/" class="ingredient-card">
          <div class="ingredient-card__img-wrap">
            <img
              src="/images/products/boswellia-extract.jpg"
              alt="Boswellia resin and bark"
              loading="lazy"
              width="480"
              height="320"
            />
            <div class="ingredient-card__overlay"></div>
          </div>
          <div class="ingredient-card__body">
            <h3 class="ingredient-card__name">Boswellia</h3>
            <p class="ingredient-card__latin">Boswellia serrata</p>
            <p class="ingredient-card__desc">Indian Frankincense, AKBA-standardised extract for joint-health formulations.</p>
            <span class="ingredient-card__link">View specifications →</span>
          </div>
        </a>

        <a href="/products/" class="ingredient-card">
          <div class="ingredient-card__img-wrap">
            <img
              src="/images/home/cardamom-pods.jpg"
              alt="Green cardamom pods"
              loading="lazy"
              width="480"
              height="320"
            />
            <div class="ingredient-card__overlay"></div>
          </div>
          <div class="ingredient-card__body">
            <h3 class="ingredient-card__name">Cardamom</h3>
            <p class="ingredient-card__latin">Elettaria cardamomum</p>
            <p class="ingredient-card__desc">Green cardamom pods, ground powder and essential oil, from Kerala, India's main cardamom-growing state.</p>
            <span class="ingredient-card__link">View specifications →</span>
          </div>
        </a>

      </div>

      <div class="strip-footer">
        <a href="/products/" class="btn btn--primary">View All Ingredient Categories</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       WHY AYRIS GLOBAL - THREE PILLARS
  ════════════════════════════════════════════════ -->
  <section class="pillars">
    <div class="container">
      <div class="section-header section-header--light">
        <span class="section-eyebrow section-eyebrow--gold">The Ayris Difference</span>
        <h2 class="section-title section-title--dark">What We Bring to Every Sourcing Partnership</h2>
      </div>
      <div class="pillars-grid">
        <div class="pillar">
          <div class="pillar__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="22" stroke="var(--turmeric)" stroke-width="1.5"/>
              <path d="M16 24 Q20 16 24 14 Q28 16 32 24 Q28 32 24 34 Q20 32 16 24Z" stroke="var(--turmeric)" stroke-width="1.5" fill="none"/>
              <circle cx="24" cy="24" r="3" fill="var(--turmeric)"/>
            </svg>
          </div>
          <h3 class="pillar__title">Origin Intelligence</h3>
          <p class="pillar__text">We start from your specification and work back to the right Indian producer: which regions grow what, which producers hold which certificates, and how season affects quality. You get a reasoned shortlist, not just a product list.</p>
        </div>
        <div class="pillar">
          <div class="pillar__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="22" stroke="var(--turmeric)" stroke-width="1.5"/>
              <path d="M14 34 L20 26 L26 30 L34 18" stroke="var(--turmeric)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="34" cy="18" r="2.5" fill="var(--turmeric)"/>
            </svg>
          </div>
          <h3 class="pillar__title">Certification Depth</h3>
          <p class="pillar__text">GMP, ISO, FSSAI, Organic (NPOP/NOP), Halal, Kosher. We request the producer certificates and documents your market asks for, so your regulatory team has what it needs to decide.</p>
        </div>
        <div class="pillar">
          <div class="pillar__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="22" stroke="var(--turmeric)" stroke-width="1.5"/>
              <path d="M24 14 L24 24 L32 28" stroke="var(--turmeric)" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M16 18 Q10 24 16 30" stroke="var(--turmeric)" stroke-width="1.2" fill="none" stroke-linecap="round"/>
              <path d="M32 18 Q38 24 32 30" stroke="var(--turmeric)" stroke-width="1.2" fill="none" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="pillar__title">Responsive Partnership</h3>
          <p class="pillar__text">Specification sheets, CoA and SDS documentation, and pricing, handled promptly and documentation-first. One point of contact from first enquiry to order.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NETWORK -->
  <section class="network">
    <div class="container">
      <div class="network__inner">
        <div class="network__text">
          <span class="section-eyebrow">Our Network</span>
          <h2 class="section-title">India is where we begin.</h2>
          <p>Most of what we source is grown, processed and documented in India, and that is where our producer relationships are deepest. Some specifications call for a botanical that India does not grow well, or at all. When that happens, we extend the search to other origins and apply the same process: specification first, documents reviewed before anything is recommended, and one point of contact for you throughout.</p>
          <div class="network__links">
            <a href="/contact/" class="btn btn--primary">Tell Us What You Need</a>
            <a href="/for-suppliers/#beyond-india" class="network__link">Producers outside India</a>
          </div>
        </div>
        <div class="network__points">
          <div class="network__point">
            <h3>India first</h3>
            <p>Ayurvedic botanicals, standardised extracts, powders and essential oils.</p>
          </div>
          <div class="network__point">
            <h3>Beyond India</h3>
            <p>On request, case by case, when a specification calls for it.</p>
          </div>
          <div class="network__point">
            <h3>Same standard</h3>
            <p>Documentation before recommendation, wherever the producer is.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CREDENTIALS BAR
  ════════════════════════════════════════════════ -->
  <section class="credentials">
    <div class="container">
      <p class="credentials__label">Producer certifications we source to</p>
      <div class="credentials-bar">
        <div class="credential">
          <span class="credential__badge">GMP</span>
          <span class="credential__label">Manufacturing</span>
        </div>
        <div class="credential">
          <span class="credential__badge">ISO</span>
          <span class="credential__label">22000 / 9001</span>
        </div>
        <div class="credential">
          <span class="credential__badge">FSSAI</span>
          <span class="credential__label">Food Safety</span>
        </div>
        <div class="credential">
          <span class="credential__badge">Organic</span>
          <span class="credential__label">NPOP / NOP</span>
        </div>
        <div class="credential">
          <span class="credential__badge">Halal</span>
          <span class="credential__label">On Request</span>
        </div>
        <div class="credential">
          <span class="credential__badge">Kosher</span>
          <span class="credential__label">On Request</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA BAND
  ════════════════════════════════════════════════ -->
  <GuidesByTopic />

  <section class="cta-band">
    <div class="container">
      <div class="cta-band__inner">
        <h2 class="cta-band__title">Ready to source from India?</h2>
        <p class="cta-band__sub">Whether you're formulating a new product line or looking for a more reliable supply partner, we'd welcome a conversation.</p>
        <div class="cta-band__actions">
          <a href="/contact/" class="btn btn--primary btn--lg">Start a Sourcing Conversation</a>
          <a href="/for-buyers/" class="btn btn--ghost btn--lg">Why Buyers Choose Ayris Global</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─────────────────────────────────────────────
     HERO
  ───────────────────────────────────────────── */
  .hero {
    background-color: var(--paper);
    min-height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7.25rem 1.5rem 4.5rem;
    position: relative;
    overflow: hidden;
  border-bottom: 1px solid var(--line);
}

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none;
    pointer-events: none;
  }

  .hero__inner {
    max-width: 980px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  /* Botanical arch */
  .hero__arch {
    margin-bottom: -0.5rem;
  }

  .arch-svg {
    width: 100%;
    max-width: 400px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  /* Wordmark */
  .hero__brand {
    margin-bottom: 1rem;
  }

  .hero__wordmark {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1;
    margin: 0 0 0.75rem;
    color: var(--ink);
  }


  /* Three-segment fade rule */
  .hero__rule-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .rule {
    display: block;
    height: 2px;
    width: clamp(60px, 12vw, 120px);
  }

  .rule--left {
    background: var(--turmeric);
  }

  .rule--right {
    background: var(--turmeric);
  }

  .rule__diamond {
    display: block;
    width: 6px;
    height: 6px;
    background: var(--turmeric);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .hero__tagline {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 0;
  }

  /* Divider below brand */
  .hero__divider {
    width: 40px;
    height: 1px;
    background: rgba(var(--turmeric-rgb), 0.6);
    margin: 1.8rem auto;
  }

  .hero__lead {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: var(--ink);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto 2.2rem;
    font-weight: 400;
  }

  .hero__cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  /* Market badges */
  .hero__markets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .market-badge {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
    border: 1px solid var(--line);
    padding: 0.25rem 0.65rem;
    border-radius: 2px;
  }

  /* ─────────────────────────────────────────────
     BUTTONS (global within this page)
  ───────────────────────────────────────────── */
  .btn {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
    padding: 0.85rem 1.8rem;
    border-radius: 3px;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn--primary {
    background: var(--turmeric);
    color: var(--ink);
    border: 2px solid var(--turmeric);
  }

  .btn--primary:hover {
    background: var(--turmeric-hover);
    border-color: var(--turmeric-hover);
  }

  .btn--outline {
    background: transparent;
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .btn--outline:hover {
    border-color: var(--ink);
    background: var(--ink);
  color: var(--paper);
}

  .btn--ghost {
    background: transparent;
    color: var(--paper);
    border: 2px solid rgba(var(--paper-rgb),0.3);
  }

  .btn--ghost:hover {
    border-color: rgba(var(--paper-rgb),0.7);
    background: rgba(var(--paper-rgb),0.05);
  }

  .btn--lg {
    padding: 1rem 2.2rem;
    font-size: 0.9rem;
  }

  /* ─────────────────────────────────────────────
     CONTAINER
  ───────────────────────────────────────────── */
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ─────────────────────────────────────────────
     SECTION HEADERS
  ───────────────────────────────────────────── */
  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-eyebrow {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .section-eyebrow--gold { color: var(--ink); }

  .section-title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .section-title--dark { color: var(--ink); }

  .section-sub {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: var(--slate);
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ─────────────────────────────────────────────
     FEATURED INGREDIENTS STRIP
  ───────────────────────────────────────────── */
  .ingredients-strip {
    background: var(--mist);
    padding: 6rem 0 5rem;
  }

  .ingredients-grid {
    display: grid;
