---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- DRAFT - legal review pending -->
<BaseLayout
  title="Terms of Use"
  description="Terms governing use of the Ayris Global website."
>

  <section class="page-hero">
    <div class="page-hero__inner">
      <span class="eyebrow">Legal</span>
      <h1 class="page-hero__title">Terms of Use</h1>
      <p class="page-hero__sub">The terms on which this website is provided.</p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="doc">
        <p class="doc__updated">Last updated: October 2026</p>

        <h2>Operator</h2>
        <p>This website is operated by Neha Rai Singh, a sole proprietorship trading as Ayris Global, based in Mumbai, Maharashtra, India. GSTIN 27CDNPS7626E3Z0.</p>

        <h2>Nature of the business</h2>
        <p>Ayris Global is a B2B sourcing and commercial-intermediation business. Content on this website is provided for general information to business visitors and is not an offer capable of acceptance.</p>

        <h2>No guarantees</h2>
        <p>Ayris Global makes no guarantee of product quality or regulatory compliance. Buyers remain responsible for their own specifications, testing, and compliance with the laws and regulations of their markets.</p>

        <h2>Use of the website</h2>
        <p>You may use this website for lawful business purposes. Website content, including text, images and the Ayris Global name and logo, may not be copied or reused without our written permission.</p>

        <h2>Changes</h2>
        <p>We may update these terms from time to time. The version published on this page applies.</p>

        <h2>Contact</h2>
        <p><a href="mailto:sourcing@ayrisglobal.in">sourcing@ayrisglobal.in</a></p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero { background: var(--mist); padding: 7rem 1.5rem 5rem; text-align: center; border-bottom: 3px solid var(--turmeric);}
  .page-hero__inner { max-width: 640px; margin: 0 auto; }
  .eyebrow { display: block; font-family: 'Inter', sans-serif; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink); margin-bottom: 1rem; }
  .page-hero__title { font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 400; color: var(--ink); margin: 0 0 1.2rem; line-height: 1.15; }
  .page-hero__sub { font-family: 'Inter', sans-serif; font-size: 1rem; color: var(--ink); line-height: 1.8; margin: 0; font-weight: 300; }
  .doc { max-width: 760px; margin: 0 auto; }
  .doc h2 { font-family: 'DM Serif Display', Georgia, serif; font-weight: 400; color: var(--ink); font-size: 1.5rem; margin: 2.5rem 0 0.75rem; }
  .doc h2:first-child { margin-top: 0; }
  .doc p, .doc li, .doc dd { font-family: 'Inter', sans-serif; font-size: 0.95rem; line-height: 1.85; color: var(--ink); }
  .doc dl { margin: 0; }
  .doc dt { font-family: 'Inter', sans-serif; font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); margin-top: 1.1rem; }
  .doc dd { margin: 0.2rem 0 0; color: var(--ink); }
  .doc a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--turmeric); text-underline-offset: 3px; }
  .doc__updated { font-size: 0.8rem !important; color: var(--slate) !important; }
</style>
