---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { clusterOf } from '../../data/clusters';
import { topicBySlug } from '../../data/topics';

// Related Articles: deterministic, build-time, cluster-aware.
// Score: same cluster +5, each shared tag +2 (capped at 6), same category +1.
// Region tags are ignored (every post carries all of them).
// Ties: newest first, then slug. A global cap keeps any post in at most
// MAX_EXPOSURE lists, and a repair pass makes sure every post appears in at
// least MIN_EXPOSURE lists. The build fails if any rule below is broken.
export async function getStaticPaths() {
  // (Astro hoists getStaticPaths, so the helper lives inside it.)
  const CARDS = 4;
  const MAX_EXPOSURE = 12;
  const MIN_EXPOSURE = 2;
  const MIN_SAME_CLUSTER = 2;

  function computeRelated(all: CollectionEntry<'blog'>[]) {
    const posts = [...all].sort((a, b) => (a.slug < b.slug ? -1 : a.slug > b.slug ? 1 : 0));
    const info = new Map(
      posts.map((p) => [
        p.slug,
        {
          post: p,
          cluster: clusterOf(p.slug),
          tags: new Set((p.data.tags ?? []).map((t) => t.toLowerCase())),
          time: new Date(p.data.pubDate).getTime(),
        },
      ])
    );
    const score = (a: string, b: string) => {
      const x = info.get(a)!;
      const y = info.get(b)!;
      let shared = 0;
      x.tags.forEach((t) => { if (y.tags.has(t)) shared++; });
      return (x.cluster === y.cluster ? 5 : 0) + Math.min(6, shared * 2) + (x.post.data.category === y.post.data.category ? 1 : 0);
    };
    const ranked = new Map<string, string[]>();
    for (const p of posts) {
      const list = posts
        .filter((q) => q.slug !== p.slug)
        .map((q) => ({ slug: q.slug, s: score(p.slug, q.slug), t: info.get(q.slug)!.time }))
        .sort((m, n) => n.s - m.s || n.t - m.t || (m.slug < n.slug ? -1 : 1));
      ranked.set(p.slug, list.map((m) => m.slug));
    }
    const selected = new Map<string, string[]>(posts.map((p) => [p.slug, []]));
    const exposure = new Map<string, number>(posts.map((p) => [p.slug, 0]));
    // Fill one card slot per round so early posts do not hog the exposure cap.
    for (let k = 0; k < CARDS; k++) {
      for (const p of posts) {
        const chosen = selected.get(p.slug)!;
        const pick = ranked.get(p.slug)!.find((q) => !chosen.includes(q) && exposure.get(q)! < MAX_EXPOSURE);
        if (!pick) throw new Error(`Related: no candidate for ${p.slug}`);
        chosen.push(pick);
        exposure.set(pick, exposure.get(pick)! + 1);
      }
    }
    const sameCount = (slug: string, list: string[]) =>
      list.filter((q) => info.get(q)!.cluster === info.get(slug)!.cluster).length;
    const needSame = (slug: string) =>
      Math.min(MIN_SAME_CLUSTER, posts.filter((q) => info.get(q.slug)!.cluster === info.get(slug)!.cluster).length - 1);
    // Repair: lift under-exposed posts by swapping into the lists they fit best.
    for (let guard = 0; guard < 2000; guard++) {
      const under = posts.find((p) => exposure.get(p.slug)! < MIN_EXPOSURE);
      if (!under) break;
      let done = false;
      for (const srcSlug of ranked.get(under.slug)!) {
        const list = selected.get(srcSlug)!;
        if (list.includes(under.slug)) continue;
        const swappable = list
          .map((q) => ({ q, s: score(srcSlug, q) }))
          .filter((m) => exposure.get(m.q)! > MIN_EXPOSURE)
          .sort((m, n) => m.s - n.s || (m.q < n.q ? -1 : 1));
        for (const { q } of swappable) {
          const next = list.map((x) => (x === q ? under.slug : x));
          if (sameCount(srcSlug, next) >= needSame(srcSlug)) {
            selected.set(srcSlug, next);
            exposure.set(q, exposure.get(q)! - 1);
            exposure.set(under.slug, exposure.get(under.slug)! + 1);
            done = true;
            break;
          }
        }
        if (done) break;
      }
      if (!done) throw new Error(`Related: cannot lift exposure for ${under.slug}`);
    }
    // Hard checks: fail the build rather than ship a bad related graph.
    for (const p of posts) {
      const list = selected.get(p.slug)!;
      if (list.length !== CARDS) throw new Error(`Related: ${p.slug} has ${list.length} cards`);
      if (list.includes(p.slug)) throw new Error(`Related: ${p.slug} lists itself`);
      if (new Set(list).size !== list.length) throw new Error(`Related: ${p.slug} has duplicate cards`);
      if (sameCount(p.slug, list) < needSame(p.slug)) throw new Error(`Related: ${p.slug} has too few same-cluster cards`);
      const e = exposure.get(p.slug)!;
      if (e < MIN_EXPOSURE || e > MAX_EXPOSURE) throw new Error(`Related: ${p.slug} exposure ${e}`);
    }
    return new Map(posts.map((p) => [p.slug, selected.get(p.slug)!.map((q) => info.get(q)!.post)]));
  }

  const posts = await getCollection('blog');
  const related = computeRelated(posts);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, related: related.get(post.slug)! },
  }));
}
type Props = {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
};
const { post, related: relatedPosts } = Astro.props;
const { Content } = await post.render();
const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const faqSchema = post.data.faqSchema;

const topic = topicBySlug(clusterOf(post.slug))!;
const topicUrl = `/topics/${topic.slug}/`;
const postUrl = `https://ayrisglobal.in/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Blog', url: 'https://ayrisglobal.in/blog/' },
  { name: topic.short, url: `https://ayrisglobal.in${topicUrl}` },
  { name: post.data.title, url: postUrl },
];
const imgUrl = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : `https://ayrisglobal.in${post.data.image.startsWith('/') ? '' : '/'}${post.data.image}`)
  : 'https://ayrisglobal.in/og-image.jpg';
const blogPostingJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: 'Ayris Global Editorial', url: 'https://ayrisglobal.in/' },
  publisher: { '@type': 'Organization', '@id': 'https://ayrisglobal.in/#organization', name: 'Ayris Global' },
  image: imgUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
}).replace(/</g, '\\u003c');

const categoryMeta: Record<string, { label: string; color: string }> = {
  'ingredients': { label: 'Ingredients & Botanicals', color: '#15803D' },
  'certifications': { label: 'Certifications & Compliance', color: '#7C3AED' },
  'sourcing': { label: 'Sourcing & Trade', color: '#0F766E' },
  'market-intelligence': { label: 'Market Intelligence', color: '#B45309' },
};

---
<BaseLayout title={post.data.title} description={post.data.description} breadcrumbs={breadcrumbs}>

  <script type="application/ld+json" set:html={blogPostingJson} slot="head" />

  <!-- FAQ JSON-LD Schema (injected via head slot when faqSchema frontmatter is present) -->
  {faqSchema && <script type="application/ld+json" set:html={faqSchema} slot="head" />}

  <!-- Hero -->
  <section style="background: var(--mist); border-bottom: 3px solid var(--turmeric); padding: 80px 24px 60px;">
    <div style="max-width: 800px; margin: 0 auto;">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/blog/">Blog</a> <span aria-hidden="true">&rsaquo;</span> <a href={topicUrl}>{topic.short}</a>
      </nav>
      <p style="color: var(--ink); font-family: Inter, sans-serif; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 16px;">
        {post.data.category}
      </p>
      <h1 style="font-family: 'DM Serif Display', serif; font-size: clamp(2rem, 4vw, 3rem); color: var(--ink); line-height: 1.2; margin-bottom: 24px;">
        {post.data.title}
      </h1>
      <p style="color: var(--slate); font-family: Inter, sans-serif; font-size: 0.95rem;">
        {formattedDate}
        {post.data.readingTime && <>&nbsp;&middot;&nbsp;{post.data.readingTime} min read</>}
      </p>
    </div>
  </section>
  <!-- Content -->
  <section style="background: var(--paper); padding: 60px 24px 80px;">
    <div style="max-width: 800px; margin: 0 auto;">
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          style="width: 100%; height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 48px;"
        />
      )}
      <div class="prose">
        <Content />
      </div>

      {relatedPosts.length > 0 && (
        <div class="related-articles">
          <h2 class="related-articles__title">Related Articles</h2>
          <div class="related-grid">
            {relatedPosts.map((rp) => {
              const color = categoryMeta[rp.data.category]?.color || 'var(--ink)';
              const label = categoryMeta[rp.data.category]?.label || rp.data.category;
              return (
                <a href={`/blog/${rp.slug}/`} class="related-card">
                  <div class="related-card__image-wrap">
                    {rp.data.image ? (
                      <img
                        src={rp.data.image}
                        alt={rp.data.imageAlt || rp.data.title}
                        class="related-card__image"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="related-card__image-fallback"></div>
                    )}
                    <span class="related-card__badge" style={`background:${color}`}>{label}</span>
                  </div>
                  <div class="related-card__body">
                    <h3 class="related-card__title">{rp.data.title}</h3>
                    <p class="related-card__desc">{rp.data.description}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Back link -->
      <div style="margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--line);">
        <a href="/blog/" style="color: var(--ink); text-decoration: underline; text-decoration-color: var(--turmeric); text-underline-offset: 4px; font-family: Inter, sans-serif; font-weight: 600; font-size: 0.95rem;">
          &larr; Back to Insights
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .crumbs { font-family: var(--font-body, Inter, sans-serif); font-size: 0.85rem; color: var(--slate); margin-bottom: 16px; }
  .crumbs a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--turmeric); text-underline-offset: 3px; }
  .crumbs span { margin: 0 6px; }
  .prose {
    font-family: Inter, sans-serif;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--ink);
  }
  .prose h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.75rem;
    color: var(--ink);
    margin-top: 48px;
    margin-bottom: 16px;
  }
  .prose h3 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.35rem;
    color: var(--ink);
    margin-top: 36px;
    margin-bottom: 12px;
  }
  .prose p {
    margin-bottom: 20px;
  }
  .prose ul, .prose ol {
    margin-bottom: 20px;
    padding-left: 24px;
  }
  .prose li {
    margin-bottom: 8px;
  }
  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }
  .prose a {
    color: var(--ink);
    text-decoration: underline;
  text-decoration-color: var(--turmeric);
  text-decoration-thickness: 2px;
  text-underline-offset: 4px;
}
  .prose blockquote {
    border-left: 3px solid var(--turmeric);
    padding-left: 20px;
    margin-left: 0;
    color: var(--slate);
    font-style: italic;
  }

  .related-articles {
    margin-top: 64px;
    padding-top: 48px;
    border-top: 1px solid var(--line);
  }

  .related-articles__title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.5rem;
    color: var(--ink);
    margin-bottom: 28px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 580px) {
    .related-grid { grid-template-columns: 1fr; }
  }

  .related-card {
    background: var(--white);
    border-radius: 12px;
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(var(--ink-rgb),0.12);
  }

  .related-card__image-wrap {
    position: relative;
    height: 140px;
    overflow: hidden;
    background: var(--ink);
    flex-shrink: 0;
  }

  .related-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .related-card:hover .related-card__image {
    transform: scale(1.04);
  }

  .related-card__image-fallback {
    width: 100%;
    height: 100%;
    background: var(--ink);
  }

  .related-card__badge {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--white);
  }

  .related-card__body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .related-card__title {
    font-family: 'DM Serif Display', serif;
    font-size: 0.95rem;
    color: var(--ink);
    line-height: 1.35;
    margin: 0 0 0.5rem;
  }

  .related-card__desc {
    font-size: 0.8rem;
    color: var(--slate);
    line-height: 1.6;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
